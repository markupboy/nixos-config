# dunst config. Linked to ~/.config/dunst/dunstrc by home-manager.
#
# Nothing execs dunst -- it is D-Bus activated on org.freedesktop.Notifications,
# so the first notification starts it. Test with:
#   notify-send "hello" "world"

[global]
    monitor = 0
    follow = mouse

    width = 400
    height = 300
    origin = top-right
    # (x, y) rather than the older 16x16 spelling, which dunst has deprecated.
    offset = (16, 16)
    scale = 0

    notification_limit = 5
    progress_bar = true

    separator_height = 2
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#4a90d9"
    separator_color = frame

    sort = yes
    idle_threshold = 120

    # Consolas 7NF is our patched Consolas; see desktop/i3.conf.
    font = Consolas 7NF 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = middle

    icon_position = off
    enable_recursive_icon_lookup = false

    sticky_history = yes
    history_length = 20

    dmenu = /run/current-system/sw/bin/rofi -dmenu -p dunst
    browser = /run/current-system/sw/bin/xdg-open

    always_run_script = true
    corner_radius = 6
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# one-dark, matching desktop/i3.conf and ghostty.
[urgency_low]
    background = "#17191d"
    foreground = "#5c6370"
    frame_color = "#434852"
    timeout = 5

[urgency_normal]
    background = "#17191d"
    foreground = "#abb2bf"
    frame_color = "#4a90d9"
    timeout = 8

[urgency_critical]
    background = "#17191d"
    foreground = "#c8cdd5"
    frame_color = "#ef596f"
    timeout = 0
